---
import { getSingleton } from "$src/utils/content/singleton";
import SvelteHeader from "$svelte/header.svelte";
import { AstroSlot } from "$utils/astro/slots";
import { JustifyNav } from "../svelte/nav/nav.svelte";
import Nav from "./nav/nav.astro";

interface Props {
  title?: string;
}
const { title } = Astro.props;

const {
  data: { header },
} = await getSingleton("navigation")!;

const extraSlot = new AstroSlot(Astro.slots, "default");
---

<SvelteHeader title={title ?? header.title} client:load>
  <slot name="nav" slot="nav">
    <Nav
      items={header.nav}
      justify={extraSlot.exists ? JustifyNav.Center : JustifyNav.Right}
    />
  </slot>
  <slot slot={extraSlot.existTernary("default")} />
</SvelteHeader>
