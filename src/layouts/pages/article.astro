---
import GsapSticky from "$src/components/svelte/actions/gsap-sticky.svelte";
import Toc from "$src/components/svelte/nav/toc.svelte";
import Prose from "$src/components/svelte/prose.svelte";
import { AstroSlot } from "$src/utils/astro/slots";
import Hero from "$svelte/heros/simple.svelte";
import { type RenderResult } from "astro:content";
import Page from "./default.astro";

interface Props {
  title: string;
  description: string;
  cover: string;
  content?: RenderResult;
}

const { title, description, cover, content } = Astro.props;

const header = new AstroSlot(Astro.slots, "header");
const footer = new AstroSlot(Astro.slots, "footer");
---

<Page {title} {description}>
  <header id="article-header" class="relative py-8 grid min-h-[70svh]">
    <img
      class="absolute top-0 left-0 size-full object-cover object-center opacity-10"
      src={cover}
      alt={description}
    />
    <!-- Note: keep the slot without a new line to allow the empty:hidden to work -->
    <Hero {title} subtitle={description}>{(<slot name="header-extra" />)}</Hero>

    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";
      gsap.registerPlugin(ScrollTrigger);

      const header = document.getElementById("article-header")!;
      const shift = "100%";
      gsap.to(header, {
        opacity: 0,
        translateY: shift,
        ease: "none",
        scrollTrigger: {
          start: "0",
          trigger: header,
          end: `bottom+=${shift} top`,
          scrub: 0,
          toggleActions: "play complete reverse reset",
        },
      });
    </script>
  </header>
  <main
    class="p-4 pt-12 gap-12 grid grid-cols-1 lg:grid-cols-[1fr_auto_1fr] app-background z-1 relative will-change-transform"
  >
    {
      content?.headings && (
        <GsapSticky
          element="aside"
          class="lg:sticky top-[5vw] h-fit max-lg:text-xl"
          onlyIfScrollSmoother
          client:visible
        >
          <Toc headings={content.headings} client:visible />
        </GsapSticky>
      )
    }

    <main>
      {
        header.exists && (
          <header>
            <slot name="header" />
          </header>
        )
      }

      {
        content ? (
          <Prose>
            <content.Content />
          </Prose>
        ) : (
          <slot />
        )
      }

      {
        footer.exists && (
          <footer>
            <slot name="footer" />
          </footer>
        )
      }
    </main>
  </main>
</Page>
