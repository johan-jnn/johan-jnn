---
import GsapSticky from "$src/components/svelte/actions/gsap-sticky.svelte";
import Toc from "$src/components/svelte/nav/toc.svelte";
import Prose from "$src/components/svelte/prose.svelte";
import { AstroSlot } from "$src/utils/astro/slots";
import Hero from "$svelte/heros/simple.svelte";
import { type RenderResult } from "astro:content";
import Page, { type Props as PageProps } from "./default.astro";
import merge from "lodash.merge";

interface Props extends Omit<PageProps, "without_defaults"> {
  cover: string;
  author?:
    | string
    | {
        first_name: string;
        last_name: string;
        username: string;
        gender: "male" | "female";
      };
  category?: string;
  tags?: string[];
  published_at?: Date;
  modified_at?: Date;
  expires_at?: Date;

  content?: RenderResult;
}

const {
  title,
  description,

  cover,
  author,
  category,
  expires_at,
  modified_at,
  published_at,
  tags,
  content,

  seo = {},
  ...parent
} = Astro.props;

merge(seo, {
  titleTemplate: "%s | Johan JANIN's portfolio",
  openGraph: {
    basic: {
      title,
      image: cover,
      type: "article",
    },
    article: {
      tags,
      section: category,
      expirationTime: expires_at?.toISOString(),
      modifiedTime: modified_at?.toISOString(),
      publishedTime: published_at?.toISOString(),
    },
  },
} satisfies typeof seo);

if (author) {
  seo.openGraph!.article!.authors = [
    typeof author === "string" ? author : author.username,
  ];

  if (typeof author === "object") {
    merge(seo, {
      extend: {
        meta: Object.entries(author).map(([key, content]) => ({
          name: `profile:${key}`,
          content,
        })),
      },
    } satisfies typeof seo);
  }
}

const header = new AstroSlot(Astro.slots, "header");
const footer = new AstroSlot(Astro.slots, "footer");
const pageFooter = new AstroSlot(Astro.slots, "page-footer");
---

<Page {title} {description} {seo} {...parent}>
  <header id="article-header" class="relative py-8 grid min-h-[70svh]">
    <img
      class="absolute top-0 left-0 size-full object-cover object-center opacity-10"
      src={cover}
      alt={description}
    />
    <!-- Note: keep the slot without a new line to allow the empty:hidden to work -->
    <Hero {title} subtitle={description}>{(<slot name="header-extra" />)}</Hero>

    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";
      gsap.registerPlugin(ScrollTrigger);
      const shift = "100%";

      document.addEventListener(
        "astro:page-load",
        function (this: Window & { animation?: gsap.core.Tween }) {
          this.animation?.kill();

          const header = document.getElementById("article-header")!;
          this.animation = gsap.to(header, {
            opacity: 0,
            translateY: shift,
            ease: "none",
            scrollTrigger: {
              start: "0",
              trigger: header,
              end: `bottom+=${shift} top`,
              scrub: 0,
              toggleActions: "play complete reverse reset",
            },
          });
        },
      );
    </script>
  </header>
  <main
    class="p-4 pt-12 gap-12 grid grid-cols-1 lg:grid-cols-[auto_1fr] app-background z-1 relative will-change-transform"
  >
    {
      content?.headings && (
        <GsapSticky
          element="aside"
          class="lg:sticky top-22 h-fit max-lg:text-xl"
          onlyIfScrollSmoother
          client:visible
        >
          <Toc headings={content.headings} client:visible />
        </GsapSticky>
      )
    }

    <main>
      {
        header.exists && (
          <header>
            <slot name="header" />
          </header>
        )
      }

      <slot name="before" />
      {
        content ? (
          <Prose>
            <content.Content />
          </Prose>
        ) : (
          <slot />
        )
      }
      <slot name="after" />

      {
        footer.exists && (
          <footer>
            <slot name="footer" />
          </footer>
        )
      }
    </main>
  </main>

  {
    pageFooter.exists && (
      <footer>
        <slot name="page-footer" />
      </footer>
    )
  }
</Page>
