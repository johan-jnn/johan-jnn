---
import Header from "$astro/header.astro";
import Html from "$layouts/html.astro";
import Ambiance from "$src/components/astro/audio/ambiance.astro";
import Smoother from "$src/components/svelte/animations/scroll/smoother.svelte";
import Footer from "$src/components/svelte/footer.svelte";
import Style from "$src/styles/style.astro";
import { AstroSlot } from "$src/utils/astro/slots";

interface Props {
  title: string;
  description: string;
  lang?: string;

  without_defaults?: {
    header?: boolean;
    footer?: boolean;
    head?: boolean;
  };
}

const { lang, title, description, without_defaults } = Astro.props;
---

<Html {lang}>
  <Fragment slot="head">
    {!without_defaults?.head && (
      <Style />
      <title>{title}</title>
      <meta name="description" content={description} />
    )}
    <slot name="head" />
  </Fragment>

  <Fragment slot="body-top">
    {
      without_defaults?.header
      ? <slot name="header"/>
      : (
      <Header>
        <slot name="header-nav" slot={new AstroSlot(Astro.slots, "header-nav").existTernary("nav")} />
        <slot name="header-extra" slot={new AstroSlot(Astro.slots, "header-extra").existTernary("default")} />
      </Header>
      )
    }
    <slot name="body-top" />
  </Fragment>

  <Smoother
  dom={{
    wrapper: {
      element: 'main',
      class: 'relative z-1 pointer-events-none'
    },
    content: {
      class: 'sm:pt-15 pb-(--footer-height)'
    },
  }} 
  vars={{
    // smooth: false,
    effects: "[data-speed], [data-lag]"
  }}
  client:load>
    <div
      id="content"
      class="app-background border-b-2 border-black dark:border-white pointer-events-auto min-h-screen"
    >
      <slot name="before-content" />
      <slot />
      <slot name="after-content" />
    </div>
  </Smoother>

  <Fragment slot="body-bottom">
    <slot name="body-bottom" />
    {
      without_defaults?.footer
      ? <slot name="footer" />
      : <Footer client:load />
    }
  </Fragment>

</Html>
