---
import Header from "$astro/header.astro";
import Html from "$layouts/html.astro";
import Style from "$src/styles/style.astro";

interface Props {
  title: string;
  description: string;
  lang?: string;

  without_defaults?: {
    header?: boolean;
    footer?: boolean;
    head?: boolean;
  };
}

const { props } = Astro;
---

<Html lang={props.lang}>
  <Fragment slot="head">
    {!props.without_defaults?.head && (
      <Style />
      <title>{props.title}</title>
      <meta name="description" content={props.description} />
    )}

    <slot name="head" />
  </Fragment>

  <Fragment slot="body-top">
    {
      props.without_defaults?.header
      ? <slot name="header"/>
      : (
      <Header>
        <slot name="header-nav" slot="nav" />
        <slot name="header-extra" />
      </Header>
      )
    }

    <slot name="body-top" />
  </Fragment>

  <main>
    <slot name="before-content" />
    <slot />
    <slot name="after-content" />
  </main>

  <Fragment slot="body-bottom">
    <slot name="body-bottom" />
  </Fragment>
</Html>
