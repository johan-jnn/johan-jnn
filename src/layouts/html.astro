---
import Ambiance from "$src/components/astro/audio/ambiance.astro";
import Console from "$src/components/astro/console.astro";
import Toaster from "$svelte/toaster.svelte";
import { type SEOProps, SEO } from "astro-seo";
import { ClientRouter } from "astro:transitions";
import merge from "lodash.merge";

export interface Props {
  lang?: string;
  favicon?: string;
  /**
   * The theme color of the page
   * @see https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/meta/name/theme-color
   * @default {dark: "#ffb466", light: "#ff7f11"}
   */
  theme?:
    | string
    | {
        dark: string;
        light: string;
      };
  seo?: Omit<SEOProps, "charset">;
}
const {
  lang = "fr",
  favicon = "/api/logo/random?background=var(--primary)&with-shield=no&with-gap=yes&no-redirect",
  theme = { dark: "#ffb466", light: "#ff7f11" },
  seo = {},
} = Astro.props;

merge(seo, {
  charset: "UTF-8",
  extend: {
    link: [
      {
        rel: "shortcut icon",
        href: favicon,
      },
    ],
    meta: [
      {
        name: "viewport",
        content: "width=device-width, initial-scale=1.0",
      },
      ...(typeof theme === "string"
        ? [
            {
              name: "theme-color",
              content: theme,
            },
          ]
        : Object.entries(theme).map(([scheme, content]) => ({
            name: "theme-color",
            content,
            media: `(prefers-color-scheme:${scheme})`,
          }))),
    ],
  },
} satisfies SEOProps);
---

<!doctype html>
<html {lang}>
  <head>
    <SEO titleDefault="Johan JANIN's portfolio" {...seo} />

    <slot name="head" />
    <ClientRouter />
    <Console />
  </head>
  <body class="app-background">
    <slot name="body-top" />
    <slot />
    <slot name="body-bottom" />

    <Ambiance transition:persist="ambiance-controller" />
    <Toaster client:load />
  </body>
</html>
