---
import { ClientRouter } from "astro:transitions";

interface Props {
  lang?: string;
}
const { lang = "fr" } = Astro.props;
---

<!doctype html>
<html {lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <slot name="head" />

    <ClientRouter />
  </head>
  <body class="app-background">
    <slot name="body-top" />
    <slot />
    <slot name="body-bottom" />
  </body>
</html>
