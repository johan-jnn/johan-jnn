---
import "@splidejs/splide/dist/css/splide.min.css";
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";

import Article from "$layouts/pages/article.astro";
import Share from "$src/components/svelte/sections/share.svelte";
import { Splide, SplideSlide } from "astro-splide";
import { getEntry, render } from "astro:content";

export const getStaticPaths = (async () => {
  const projects = await getCollection("projects");

  return projects.map(({ data: project }) => ({
    params: { project: project.overview.slug },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;

const title = project.presentation?.title ?? project.overview.name;
const description =
  project.presentation?.subtitle ?? project.overview.description;
const category = await getEntry(project.overview.category);

const rendered = await render(await getEntry("projects", project.id)!);
---

<Article
  {title}
  {description}
  cover={project.overview.cover}
  content={rendered}
>
  <ul slot="header-extra">
    <li>
      Type: {category.data.title}
    </li>
    <li>
      Date: {
        project.overview.date.toLocaleDateString("fr-FR", { dateStyle: "long" })
      }
    </li>
  </ul>

  {
    project.gallery?.length && (
      <Fragment slot="after">
        <br class="block mt-10" />
        <Splide
          options={{
            arrows: false,
            autoWidth: true,
            pagination: false,
            autoplay: true,
            interval: 5000,
            gap: "1rem",
            rewind: false,
            pauseOnHover: true,
          }}
          class="nth-last-[-n-2]:m-0!"
        >
          {/* 
            ? Note :
            
            To prevent the last slide to be locked in the left side of the device on mobile,
            we add an extra slide.
            And, to prevent this slide to create an extra space (as splide uses margin to gap the slides),
            we remove those margins for the 2 last slides (including the fake one).
          */}

          {project.gallery.map((url, index, { length }) => (
            <SplideSlide
              class:list={{
                "m-0!": index === length - 1,
              }}
            >
              <img
                class="h-120"
                src={url}
                alt={url.match(/[^\/]+(?=\.\w+)/)?.toString()}
              />
            </SplideSlide>
          ))}

          <SplideSlide aria-hidden class="m-0!" />
        </Splide>
      </Fragment>
    )
  }

  <Fragment slot="footer">
    <hr />

    <div class="pb-12">
      <Share
        title={project.overview.name}
        description={project.overview.description}
        url={Astro.url.toString()}
        client:visible
      />
    </div>
  </Fragment>
</Article>
