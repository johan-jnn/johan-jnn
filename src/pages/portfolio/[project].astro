---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";

import Article from "$layouts/pages/article.astro";
import Share from "$src/components/svelte/sections/share.svelte";
import { getEntry, render } from "astro:content";

export const getStaticPaths = (async () => {
  const projects = await getCollection("projects");

  return projects.map(({ data: project }) => ({
    params: { project: project.overview.slug },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;

const title = project.presentation?.title ?? project.overview.name;
const description =
  project.presentation?.subtitle ?? project.overview.description;
const category = await getEntry(project.overview.category);

const rendered = await render(await getEntry("projects", project.id)!);
---

<Article
  {title}
  {description}
  cover={project.overview.cover}
  content={rendered}
>
  <ul slot="header-extra">
    <li>
      Type: {category.data.title}
    </li>
    <li>Date: {project.overview.date.toLocaleDateString()}</li>
  </ul>

  <Fragment slot="header">
    <hr />

    <Share
      title={project.overview.name}
      description={project.overview.description}
      url={Astro.url.toString()}
    />
  </Fragment>
</Article>
