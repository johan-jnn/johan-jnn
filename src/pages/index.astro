---
import Page from "$layouts/pages/default.astro";
import Project from "$src/components/svelte/cards/project.svelte";
import Button from "$svelte/button.svelte";
import Techno from "$svelte/cards/techno.svelte";
import Hero from "$svelte/heros/index.svelte";

import FillingBar from "$src/components/svelte/animations/loaders/filling-bar.svelte";
import Contact from "$svelte/sections/contact.svelte";
import Section from "$svelte/sections/simple.svelte";

import { getSingleton } from "$src/utils/content/singleton";
import { getEntries, getEntry } from "astro:content";
const { data: Homepage } = await getSingleton("home")!;

const technos = await getEntries(Homepage.sections.technos.technos ?? []);
const projects = await getEntries(Homepage.sections.projects.projects ?? []);
---

<Page
  title="Johan JANIN - Développeur Full-Stack"
  description="Johan JANIN : développeur web Full-Stack basé à Lyon, France."
>
  <ul class="flex items-center justify-end gap-2" slot="header-extra">
    <li>
      <Button
        level="primary"
        action={{
          url: "/contact",
        }}
      >
        Me contacter
      </Button>
    </li>
  </ul>

  <header>
    <Hero data-swap-id="index-hero" client:load {...Homepage.hero} />
  </header>
  <main>
    {
      technos.length && (
        <Section {...Homepage.sections.technos.section}>
          <ul class="flex max-md:flex-wrap max-md:max-w-120 max-md:mx-auto items-center justify-stretch py-4 gap-8">
            {technos.map(({ data }, index) => {
              return (
                <li class="w-full">
                  <Techno
                    {...data}
                    color={data.color ?? "var(--color-primary)"}
                  >
                    <FillingBar
                      fill={{ frequency: index % 3 }}
                      fillColor="var(--theme)"
                      delimiters={
                        Math.random() > 0.5 &&
                        Math.floor(Math.random() * 25) + 10
                      }
                      client:visible
                    />
                  </Techno>
                </li>
              );
            })}
          </ul>
          <Button
            action={{
              url: "/stack",
            }}
            level="neutral"
            boxingClass="mt-8 block w-fit mx-auto"
            stylingClass="w-fit"
          >
            Voir toute ma boite à outils
          </Button>
        </Section>
      )
    }

    {
      projects.length && (
        <Section {...Homepage.sections.projects.section}>
          <ul class="flex max-sm:flex-col max-sm:max-w-120 mx-auto items-stretch justify-stretch sm:justify-center sm:h-[50svh] gap-6">
            {projects.map(async ({ data }) => {
              return (
                <li class="sm:h-full max-sm:w-full aspect-9/10 sm:aspect-4/5">
                  <Project
                    {...data.overview}
                    category={(await getEntry(data.overview.category)).data}
                  />
                </li>
              );
            })}
          </ul>
          <Button
            action={{
              url: "/portfolio",
            }}
            level="secondary"
            boxingClass="mx-auto block w-fit mt-8"
            stylingClass="w-fit py-4"
          >
            Voir tous mes projets
          </Button>
        </Section>
      )
    }

    <Contact
      id="contact"
      title="Ready to sync ?"
      subtitle="Initiate ping // démarrer la collaboration"
      client:visible
    />
  </main>
</Page>
