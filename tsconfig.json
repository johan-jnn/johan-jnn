{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "paths": {
      "$src/*": ["./src/*"],

      "$data/*": ["./src/data/*"],
      "$utils/*": ["./src/utils/*"],
      "$types/*": ["./src/types/*"],
      "$content/*": ["./src/content/*"],

      "$pages/*": ["./src/pages/*"],
      "$layouts/*": ["./src/layouts/*"],

      "$svelte/*": ["./src/components/svelte/*"],
      "$astro/*": ["./src/components/astro/*"]
    }
  }
}
